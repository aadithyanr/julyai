# ========================================
# JulyAI Backend Environment Variables (.example)
# ========================================

BACKEND_URL=http://localhost:8020
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://julyai.currycoders.link

# --- AI Models ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=8192

# --- Database Integration (Supabase) ---
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_KEY=YOUR_SERVICE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_KEY

# Direct Postgres URL for auto-migration (optional, but recommended)
# Find in: Supabase Dashboard > Settings > Database > Connection String (URI)
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

DATASET_DATA_DIR=../data
